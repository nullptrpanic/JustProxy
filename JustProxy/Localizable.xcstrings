    "If you contact us by email, your message is used only to handle your inquiry. The online policy is hosted by GitHub Pages; its hosting privacy policy applies when you visit the website.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you contact us by email, your message is used only to handle your inquiry. The online policy is hosted by GitHub Pages; its hosting privacy policy applies when you visit the website."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如主动通过邮件联系我们，邮件内容仅用于处理你的咨询。网页版政策由 GitHub Pages 托管，访问网页时适用其托管服务隐私政策。"
          }
        }
      }
    },
    "JustProxy requires no account or sign-in, includes no ads or third-party analytics SDKs, and does not upload proxy traffic or connection records to developer-operated servers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JustProxy requires no account or sign-in, includes no ads or third-party analytics SDKs, and does not upload proxy traffic or connection records to developer-operated servers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JustProxy 无需注册或登录，不集成广告或第三方统计 SDK，也不向开发者服务器上传代理流量或连接记录。"
          }
        }
      }
    },
